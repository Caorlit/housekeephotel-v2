APP_NAME="Housekeep Hotel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.housekeephotel.com

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Database MySQL di Hostinger (hPanel → Database → MySQL)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Niente Redis su Hostinger: sessioni e cache nel database, code sincrone.
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Email (casella Hostinger)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@housekeephotel.com"
MAIL_FROM_NAME="${APP_NAME}"

# Usati solo da "php artisan db:seed" per creare il primo superadmin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
